<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Rider.master.cs" Inherits="WebApplication1.RiderMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Rider - Local Delivery Marketplace</title>
    <link href="Content/site.css" rel="stylesheet" />
</head>
<body>
    <form id="form1" runat="server">
        <div class="topbar">
            <a class="brand" href="RiderHome.aspx">Local Delivery Marketplace &middot; Rider</a>
            <div class="user">
                <asp:Label ID="whoAmI" runat="server"></asp:Label>
                <asp:Button ID="logoutBtn" runat="server" Text="Log out" CssClass="btn-logout" OnClick="logout" />
            </div>
        </div>

        <%-- Rider menu: every rider page is reached from here --%>
        <div class="nav">
            <asp:HyperLink ID="navHome" runat="server" NavigateUrl="~/RiderHome.aspx">My deliveries</asp:HyperLink>
            <asp:HyperLink ID="navPerformance" runat="server" NavigateUrl="~/RiderPerformance.aspx">My performance</asp:HyperLink>
        </div>

        <div class="container">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
